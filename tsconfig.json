{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "types": ["bun"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["job-search/src/**/*.ts", "job-search/app/**/*.ts", "job-search/app/**/*.tsx", "job-search/tests/**/*.ts", "scripts/**/*.ts", "vite.config.ts"]
}
