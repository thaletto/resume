{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "types": ["bun"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["job-search/domain/**/*.ts", "job-search/server/**/*.ts", "job-search/cli/**/*.ts", "job-search/app/**/*.ts", "job-search/app/**/*.tsx", "scripts/**/*.ts", "vitest.config.ts", "vite.config.ts"]
}
